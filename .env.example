# Generate real keys with python scripts/setup.py. Never commit .env.
REWIND_ADMIN_TOKEN=
REWIND_DEVICE_TOKEN=
REWIND_DEVICE_ID=necklace-01
REWIND_DATA_DIR=data
REWIND_PROVIDER=ollama
REWIND_OLLAMA_URL=http://127.0.0.1:11434
# llama.cpp uses /v1/chat/completions at OLLAMA_URL; embeddings still require Ollama.
REWIND_LOCAL_INFERENCE_API=ollama
REWIND_VISION_MODEL=qwen3.5:35b-a3b-q4_K_M
REWIND_REASONING_MODEL=qwen3.5:35b-a3b-q4_K_M
# Bounded structured observation requests; enable only after benchmarking latency.
REWIND_OLLAMA_THINK=false
# Tune these against a real throughput/recall-latency benchmark.
REWIND_OLLAMA_CONTEXT=16384
REWIND_OLLAMA_TIMEOUT=180
# Optional separate local queue/model for questions; blank values inherit above.
# Both inference endpoints use LOCAL_INFERENCE_API. llama.cpp context is set at server launch.
# The recall model must accept images. This does not change transcription or labeling.
REWIND_OLLAMA_RECALL_URL=
REWIND_OLLAMA_RECALL_MODEL=
REWIND_OLLAMA_RECALL_CONTEXT=16384
# Keep small text embeddings on another service to avoid evicting the vision model.
REWIND_OLLAMA_EMBEDDING_URL=
# REWIND_OLLAMA_RECALL_THINK=false
REWIND_RECALL_MAX_IMAGES=3
REWIND_EMBEDDING_MODEL=nomic-embed-text
REWIND_EMBEDDINGS=true
# Optional pixel retrieval: install .[vision] and run scripts/setup_visual.py first.
REWIND_VISUAL_EMBEDDINGS=false
REWIND_VISUAL_DEVICE=cpu
REWIND_WHISPER_MODEL=small.en
REWIND_WHISPER_DEVICE=cpu
REWIND_WHISPER_COMPUTE=int8
REWIND_WORKERS=1
REWIND_MAX_STORAGE_GB=100
REWIND_MIN_FREE_GB=2
REWIND_TIMEZONE=America/New_York
# OpenAI is optional and only used if provider=openai.
REWIND_OPENAI_API_KEY=
REWIND_OPENAI_MODEL=gpt-4.1-mini
# Optional Elastic search mirror, not required to capture or retrieve.
REWIND_ELASTIC_URL=
REWIND_ELASTIC_API_KEY=
REWIND_COOKIE_SECURE=false
# Optional reusable eight-digit admin code for loopback-only testing. Leave empty on deployed servers.
REWIND_TEST_LOGIN_CODE=
# Phone QR links must point to this server's reachable HTTPS address.
REWIND_PUBLIC_URL=
# Read-only Notch bridge. Keep the capability token on the backend, never in the phone URL.
REWIND_NOTCH_URL=
REWIND_NOTCH_TOKEN=
REWIND_NOTCH_CONTROL_URL=
# Private loopback port forwarded to rewind.processing on the ASUS over SSH/Tailscale.
REWIND_PROCESSING_URL=
REWIND_PROCESSING_TOKEN=
REWIND_COMPACT_OBSERVATIONS=false
REWIND_OBSERVATION_MAX_TOKENS=128
# Uses this Mac's existing Codex login; no API key. Astra verifies, Sol resolves disagreements.
REWIND_CODEX_VERIFY=false
REWIND_CODEX_BINARY=/Applications/ChatGPT.app/Contents/Resources/codex
REWIND_CODEX_VERIFY_TIMEOUT=120
REWIND_CODEX_VERIFY_WORKERS=2
